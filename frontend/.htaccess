# ─────────────────────────────────────────────────────────────────────────────
# skyconsults.in — cPanel / LiteSpeed .htaccess
# Place this file in public_html/ (the document root for skyconsults.in).
# ─────────────────────────────────────────────────────────────────────────────

Options -MultiViews
RewriteEngine On

# ── 1. Force HTTPS ────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── 2. Flask API proxy ────────────────────────────────────────────────────────
# All requests to /api/* are forwarded to the Flask app running on port 5000
# via cPanel's Passenger (Python app) or a reverse-proxy vhost.
#
# OPTION A – If using cPanel "Setup Python App" (Passenger):
#   The Python app is mounted at /api in your cPanel Python App config.
#   No extra rules needed here; Passenger handles /api automatically.
#
# OPTION B – If running Flask manually (gunicorn on port 5000):
#   Uncomment the four lines below:
#
# RewriteCond %{REQUEST_URI} ^/api/ [NC]
# RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
# ProxyPassReverse /api/ http://127.0.0.1:5000/api/

# ── 3. React SPA fallback ─────────────────────────────────────────────────────
# All other requests that are NOT real files or directories are served
# index.html so React Router can handle client-side navigation.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/api/ [NC]
RewriteRule ^ index.html [L]

# ── 4. Security headers ───────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── 5. Gzip compression ───────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── 6. Cache static assets ───────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css   "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
